OPENAI_API_KEY=
# Optional: enables Cohere reranking of 100 candidates down to 20 passages.
COHERE_KEY=
# Configure each stage independently. Both default to Terra.
EXTRACTION_MODEL=gpt-5.6-terra
VERIFICATION_MODEL=gpt-5.6-terra
# Verify only the first N verifiable claims unless --claim-limit overrides it.
VERIFICATION_CLAIM_LIMIT=20
# Small embedding model used for indexing and evidence search queries.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
MAX_TOOL_CALLS=20
